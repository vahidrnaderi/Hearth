{
  "name": "hearth-vscode",
  "displayName": "Hearth (Local AI)",
  "description": "Local-first, model-agnostic coding assistant",
  "version": "0.0.1",
  "publisher": "hearth",
  "license": "Apache-2.0",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": ["Other"],
  "activationEvents": ["onStartupFinished"],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "hearth",
          "title": "Hearth",
          "icon": "$(flame)"
        }
      ]
    },
    "views": {
      "hearth": [
        {
          "type": "webview",
          "id": "hearth.chat",
          "name": "Chat"
        }
      ]
    },
    "commands": [
      {
        "command": "hearth.showInfo",
        "title": "Hearth: Show Core Info"
      },
      {
        "command": "hearth.openChat",
        "title": "Hearth: Open Chat"
      },
      {
        "command": "hearth.setOpenAiApiKey",
        "title": "Hearth: Set OpenAI-compatible API Key"
      }
    ],
    "configuration": {
      "title": "Hearth",
      "properties": {
        "hearth.ollama.enabled": {
          "type": "boolean",
          "default": true,
          "description": "List and chat via local Ollama."
        },
        "hearth.ollama.baseUrl": {
          "type": "string",
          "default": "http://127.0.0.1:11434",
          "description": "Ollama server base URL."
        },
        "hearth.openaiCompatible.enabled": {
          "type": "boolean",
          "default": false,
          "description": "List and chat via an OpenAI-compatible HTTP API (LM Studio, llama.cpp server, etc.)."
        },
        "hearth.openaiCompatible.baseUrl": {
          "type": "string",
          "default": "http://127.0.0.1:1234/v1",
          "description": "Base URL for /models and /chat/completions."
        }
      }
    }
  },
  "scripts": {
    "build": "pnpm --filter @hearth/webview run build && node esbuild.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@hearth/core": "workspace:*",
    "@hearth/model-gateway": "workspace:*",
    "@hearth/shared": "workspace:*"
  },
  "devDependencies": {
    "@types/vscode": "^1.95.0",
    "esbuild": "^0.25.12",
    "typescript": "^5.9.3"
  }
}
